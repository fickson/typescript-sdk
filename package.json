{
  "name": "@sekuire/sdk",
  "version": "0.1.24",
  "description": "Sekuire Identity Protocol SDK for TypeScript/JavaScript",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "biome check src/**/*.ts",
    "lint:fix": "biome check src/**/*.ts --write",
    "format": "biome format src/**/*.ts --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:runtime": "node scripts/release-preflight.mjs --check-runtime --check-k8s --skip-build --skip-test --skip-package-smoke",
    "release:smoke:npm": "node scripts/release-preflight.mjs --mode=postpublish"
  },
  "keywords": [
    "ai",
    "agent",
    "governance",
    "identity",
    "policy",
    "verification",
    "cryptography",
    "ed25519",
    "oags",
    "typescript",
    "javascript"
  ],
  "author": "Sekuire Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekuire/sekuire.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "blake3": "^2.1.7",
    "eventsource": "^2.0.2",
    "js-yaml": "^4.1.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-dynamodb": "^3.985.0",
    "@aws-sdk/lib-dynamodb": "^3.985.0",
    "@biomejs/biome": "^1.9.4",
    "@google/genai": "^1.40.0",
    "@libsql/client": "^0.14.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.29.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.29.0",
    "@opentelemetry/sdk-trace-base": "^1.29.0",
    "@opentelemetry/semantic-conventions": "^1.29.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eventsource": "^1.1.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.27",
    "@types/uuid": "^9.0.8",
    "@upstash/redis": "^1.34.0",
    "@vitest/coverage-v8": "^1.6.1",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "convex": "^1.17.0",
    "dotenv": "^17.2.3",
    "jsdom": "^23.2.0",
    "openai": "^6.18.0",
    "rollup": "^4.54.0",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.50.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@google/genai": "^1.0.0",
    "@libsql/client": "^0.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.50.0",
    "@opentelemetry/resources": "^1.20.0",
    "@opentelemetry/sdk-trace-base": "^1.20.0",
    "@opentelemetry/semantic-conventions": "^1.20.0",
    "@upstash/redis": "^1.28.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.0.0",
    "convex": "^1.10.0",
    "dotenv": "^16.0.0",
    "node-fetch": "^2.6.0",
    "openai": "^4.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0"
  },
