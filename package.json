      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "cheerio": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "node-fetch": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "convex": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@types/pg": "^8.16.0",
    "pg": "^8.16.3",
    "redis": "^5.10.0"
  }
}
